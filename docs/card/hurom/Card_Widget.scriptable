{
  "always_run_in_app": false,
  "icon": {
    "color": "brown",
    "glyph": "id-card"
  },
  "name": "(주)휴롬 전자명함 위젯",
  "script": "// Variables used by Scriptable.\n// These must be at the very top of the file. Do not edit.\n// icon-color: brown; icon-glyph: id-card;\n/**\n * (주)휴롬 아이폰(iOS) 홈 화면 전자명함 위젯 (안드로이드 100% 동일 모양 · 전화/이메일/홈페이지/지도 즉시 연결)\n */\n\nconst COMPANY_SLUG = \"hurom\";\nconst COMPANY_NAME = \"(주)휴롬\";\nconst LOGO_SUB_EN = \"Your health, Our priority\";\nconst DOMAIN_URL = \"https://www.hurom.co.kr\";\nconst CLOUD_BASE_URL = \"https://j2u11838.github.io\";\nconst WEB_LABEL = \"www.hurom.co.kr\";\nconst COMP_ADDR = \"경남 김해시 주촌면 골든루트로 80-60\";\nconst KAKAO_CHANNEL = \"\";\n\nconst LOGO_B64 = {\n  BROWN: \"\",\n  CHARCOAL: \"\",\n  IVORY: \"\",\n  WATERMARK: \"\"\n};\n\nconst PROFILES = {\"jeong\": {\"slug\": \"jeong\", \"ownerName\": \"정혁 구매본부 | 구매1팀 | 팀장\", \"nameKr\": \"정혁\", \"nameKrSpaced\": \"정 혁\", \"titleKr\": \"|  구매본부 | 구매1팀 | 팀장\", \"personEn\": \"Jeong Hyuk  |  Purchasing Team 1 Manager\", \"phone\": \"010-4124-9617\", \"email\": \"hjeong@hurom.com\", \"cardUrl\": \"ENC1:\", \"cardImgB64\": \"\", \"vcfUri\": \"data:text/vcard;charset=utf-8;base64,\"}};\nconst SLUG_ORDER = [\"jeong\"];\n\nconst THEMES = {\n  COTTON:   { bgHex: \"#EEEBE6\", borderHex: \"#7FBC03\", primaryHex: \"#252422\", subHex: \"#5C5955\", mutedHex: \"#848484\", accentHex: \"#7FBC03\", logoKey: \"BROWN\" },\n  WHITE:    { bgHex: \"#FFFFFF\", borderHex: \"#7FBC03\", primaryHex: \"#252422\", subHex: \"#5C5955\", mutedHex: \"#848484\", accentHex: \"#7FBC03\", logoKey: \"BROWN\" },\n  SILVER:   { bgHex: \"#E2E2E6\", borderHex: \"#252422\", primaryHex: \"#252422\", subHex: \"#5C5955\", mutedHex: \"#6E6C68\", accentHex: \"#252422\", logoKey: \"CHARCOAL\" },\n  CHARCOAL: { bgHex: \"#232323\", borderHex: \"#EEEBE6\", primaryHex: \"#F5F3EF\", subHex: \"#D1CEC7\", mutedHex: \"#9E9B95\", accentHex: \"#EEEBE6\", logoKey: \"IVORY\" }\n};\n\nfunction decodeBase64Image(b64) {\n  return Image.fromData(Data.fromBase64String(b64));\n}\n\nfunction loadPrefs() {\n  const fm = FileManager.local();\n  const prefPath = fm.joinPath(fm.documentsDirectory(), \"hurom_card_widget_prefs.json\");\n  let saved = { slug: \"jeong\", theme: \"COTTON\", opacity: 96 };\n  if (fm.fileExists(prefPath)) {\n    try { saved = Object.assign(saved, JSON.parse(fm.readString(prefPath))); } catch (e) {}\n  }\n  const rawParam = (args.widgetParameter || \"\").trim();\n  if (rawParam) {\n    const parts = rawParam.split(\",\").map(s => s.trim());\n    if (parts[0] && PROFILES[parts[0].toLowerCase()]) saved.slug = parts[0].toLowerCase();\n    if (parts[1] && THEMES[parts[1].toUpperCase()]) saved.theme = parts[1].toUpperCase();\n    if (parts[2] && !isNaN(parseInt(parts[2], 10))) saved.opacity = Math.max(0, Math.min(100, parseInt(parts[2], 10)));\n  }\n  return {\n    prof: PROFILES[saved.slug] || PROFILES[\"jeong\"],\n    theme: THEMES[saved.theme] || THEMES.COTTON,\n    slug: saved.slug || \"jeong\",\n    themeKey: saved.theme || \"COTTON\",\n    opacity: saved.opacity\n  };\n}\n\nfunction savePrefs(slug, themeKey, opacity) {\n  const fm = FileManager.local();\n  const prefPath = fm.joinPath(fm.documentsDirectory(), \"hurom_card_widget_prefs.json\");\n  fm.writeString(prefPath, JSON.stringify({ slug, theme: themeKey, opacity }));\n}\n\nfunction createAndroidIdenticalBgImage(theme, opacityPct) {\n  const w = 840;\n  const h = 420;\n  const dc = new DrawContext();\n  dc.size = new Size(w, h);\n  dc.opaque = false;\n  dc.respectScreenScale = false;\n\n  const alpha = Math.max(0, Math.min(1, opacityPct / 100));\n  const bgPath = new Path();\n  bgPath.addRoundedRect(new Rect(4, 4, w - 8, h - 8), 38, 38);\n  dc.addPath(bgPath);\n  dc.setFillColor(new Color(theme.bgHex, alpha));\n  dc.fillPath();\n\n  const borderPath = new Path();\n  borderPath.addRoundedRect(new Rect(4, 4, w - 8, h - 8), 38, 38);\n  dc.addPath(borderPath);\n  dc.setStrokeColor(new Color(theme.borderHex, Math.min(1, alpha + 0.08)));\n  dc.setLineWidth(3);\n  dc.strokePath();\n\n  return dc.getImage();\n}\n\nasync function buildWidget(state) {\n  const { prof, theme, opacity } = state;\n  const w = new ListWidget();\n  w.backgroundColor = new Color(\"#000000\", 0);\n  w.backgroundImage = createAndroidIdenticalBgImage(theme, opacity);\n  w.setPadding(10, 14, 10, 14);\n\n  const scriptName = encodeURIComponent(Script.name());\n  const selfRunUrl = `scriptable:///run/${scriptName}`;\n  const interactiveCardUrl = `${CLOUD_BASE_URL}/${COMPANY_SLUG}/${prof.slug}`;\n  w.url = interactiveCardUrl;\n\n  const mainRow = w.addStack();\n  mainRow.layoutHorizontally();\n  mainRow.centerAlignContent();\n\n  const leftCol = mainRow.addStack();\n  leftCol.layoutVertically();\n  leftCol.centerAlignContent();\n  leftCol.size = new Size(96, 0);\n  leftCol.url = DOMAIN_URL;\n\n  const logoImg = decodeBase64Image(LOGO_B64[theme.logoKey]);\n  const ivLogo = leftCol.addImage(logoImg);\n  ivLogo.imageSize = new Size(64, 64);\n  ivLogo.centerAlignImage();\n\n  leftCol.addSpacer(6);\n  const tvFmSub = leftCol.addText(LOGO_SUB_EN);\n  tvFmSub.font = Font.boldSystemFont(7.5);\n  tvFmSub.textColor = new Color(theme.accentHex);\n  tvFmSub.lineLimit = 1;\n\n  mainRow.addSpacer(6);\n\n  const divider = mainRow.addStack();\n  divider.size = new Size(1.5, 118);\n  divider.backgroundColor = new Color(theme.accentHex);\n\n  mainRow.addSpacer(12);\n\n  const rightCol = mainRow.addStack();\n  rightCol.layoutVertically();\n\n  const topRow = rightCol.addStack();\n  topRow.layoutHorizontally();\n  topRow.centerAlignContent();\n\n  const tvCompany = topRow.addText(COMPANY_NAME);\n  tvCompany.font = Font.boldSystemFont(14);\n  tvCompany.textColor = new Color(theme.primaryHex);\n  tvCompany.lineLimit = 1;\n\n  topRow.addSpacer();\n\n  if (COMPANY_SLUG === \"fmssg\" && KAKAO_CHANNEL) {\n    const btnCh = topRow.addStack();\n    btnCh.backgroundColor = new Color(\"#FEE500\");\n    btnCh.cornerRadius = 6;\n    btnCh.setPadding(3, 5, 3, 5);\n    btnCh.url = KAKAO_CHANNEL;\n    const txtCh = btnCh.addText(\"Ch+\");\n    txtCh.font = Font.boldSystemFont(9);\n    txtCh.textColor = new Color(\"#191919\");\n    topRow.addSpacer(4);\n  }\n\n  const btnKakao = topRow.addStack();\n  btnKakao.backgroundColor = new Color(\"#FEE500\");\n  btnKakao.cornerRadius = 6;\n  btnKakao.setPadding(3, 6, 3, 6);\n  btnKakao.url = `${selfRunUrl}?action=share`;\n  const txtKakao = btnKakao.addText(\"카톡\");\n  txtKakao.font = Font.boldSystemFont(9);\n  txtKakao.textColor = new Color(\"#191919\");\n\n  topRow.addSpacer(4);\n\n  const btnSms = topRow.addStack();\n  btnSms.backgroundColor = new Color(\"#E8F3FF\");\n  btnSms.cornerRadius = 6;\n  btnSms.setPadding(3, 6, 3, 6);\n  btnSms.url = `${selfRunUrl}?action=sms`;\n  const txtSms = btnSms.addText(\"문자\");\n  txtSms.font = Font.boldSystemFont(9);\n  txtSms.textColor = new Color(\"#1B64DA\");\n\n  topRow.addSpacer(4);\n\n  const btnSet = topRow.addStack();\n  btnSet.setPadding(2, 4, 2, 4);\n  btnSet.url = `${CLOUD_BASE_URL}/${COMPANY_SLUG}/app/?user=${prof.slug}`;\n  const txtSet = btnSet.addText(\"⚙\");\n  txtSet.font = Font.boldSystemFont(11);\n  txtSet.textColor = new Color(theme.accentHex);\n\n  rightCol.addSpacer(2);\n\n  const nameRow = rightCol.addStack();\n  nameRow.layoutHorizontally();\n  nameRow.bottomAlignContent();\n  nameRow.url = interactiveCardUrl;\n\n  const tvNameKr = nameRow.addText(prof.nameKrSpaced);\n  tvNameKr.font = Font.boldSystemFont(13);\n  tvNameKr.textColor = new Color(theme.primaryHex);\n\n  if (prof.titleKr) {\n    nameRow.addSpacer(5);\n    const tvTitleKr = nameRow.addText(prof.titleKr);\n    tvTitleKr.font = Font.mediumSystemFont(10.5);\n    tvTitleKr.textColor = new Color(theme.subHex);\n  }\n\n  const tvPersonEn = rightCol.addText(prof.personEn);\n  tvPersonEn.font = Font.systemFont(9);\n  tvPersonEn.textColor = new Color(theme.mutedHex);\n\n  rightCol.addSpacer(4);\n\n  const phoneRow = rightCol.addStack();\n  phoneRow.url = `tel:${prof.phone}`;\n  const tvPhone = phoneRow.addText(`•  ${prof.phone}`);\n  tvPhone.font = Font.boldSystemFont(10.5);\n  tvPhone.textColor = new Color(theme.primaryHex);\n  tvPhone.lineLimit = 1;\n\n  const emailRow = rightCol.addStack();\n  emailRow.url = `mailto:${prof.email}`;\n  const tvEmail = emailRow.addText(`•  ${prof.email}`);\n  tvEmail.font = Font.systemFont(10);\n  tvEmail.textColor = new Color(theme.primaryHex);\n  tvEmail.lineLimit = 1;\n\n  const webRow = rightCol.addStack();\n  webRow.url = DOMAIN_URL;\n  const tvWeb = webRow.addText(`•  ${WEB_LABEL}`);\n  tvWeb.font = Font.systemFont(10);\n  tvWeb.textColor = new Color(theme.primaryHex);\n  tvWeb.lineLimit = 1;\n\n  const addrRow = rightCol.addStack();\n  addrRow.url = `https://map.naver.com/p/search/${encodeURIComponent(COMP_ADDR)}`;\n  const tvAddr = addrRow.addText(`•  ${COMP_ADDR}`);\n  tvAddr.font = Font.systemFont(8.5);\n  tvAddr.textColor = new Color(theme.subHex);\n  tvAddr.lineLimit = 1;\n\n  return w;\n}\n\nconst cur = loadPrefs();\nconst qAction = (args.queryParameters && args.queryParameters.action) ? args.queryParameters.action : \"\";\n\nif (config.runsInWidget) {\n  const widget = await buildWidget(cur);\n  Script.setWidget(widget);\n  Script.complete();\n} else if (qAction === \"view\") {\n  Safari.open(`${CLOUD_BASE_URL}/${COMPANY_SLUG}/${cur.prof.slug}`);\n  Script.complete();\n} else if (qAction === \"share\") {\n  const decUrl = (cur.prof.cardUrl && cur.prof.cardUrl.startsWith(\"ENC1:\")) ? (() => {\n    const key = \"ECardStudioRuntimeCipherKey2026!\";\n    const raw = Data.fromBase64String(cur.prof.cardUrl.slice(5)).getBytes();\n    const out = raw.map((b, i) => b ^ key.charCodeAt(i % key.length));\n    return Data.fromBytes(out).toRawString();\n  })() : (cur.prof.cardUrl || \"\");\n  if (decUrl) {\n    Safari.open(decUrl);\n  } else {\n    const cardImg = decodeBase64Image(cur.prof.cardImgB64);\n    await ShareSheet.present([cardImg]);\n  }\n  Script.complete();\n} else if (qAction === \"sms\") {\n  const cardImg = decodeBase64Image(cur.prof.cardImgB64);\n  const msg = new Message();\n  msg.body = `[${COMPANY_NAME}] ${cur.prof.ownerName} 전자명함\\n${CLOUD_BASE_URL}/${COMPANY_SLUG}/${cur.prof.slug}/`;\n    await msg.send();\n  Script.complete();\n} else {\n  const alert = new Alert();\n  alert.title = \"위젯 설정\";\n  alert.message = `현재: ${cur.prof.ownerName} · 테마: ${cur.themeKey} (${cur.opacity}%)`;\n  alert.addAction(\"카카오톡으로 전자명함 전송\");\n  alert.addAction(\"문자메시지로 전자명함 전송 (처음 만난 분)\");\n  alert.addAction(\"전자명함 열기 (전화·메일·홈페이지·지도 연결)\");\n  alert.addAction(\"임직원 선택 (목록)\");\n  alert.addAction(\"배경 테마 선택 (한지·화이트·실버·다크)\");\n  alert.addAction(\"위젯 미리보기\");\n  alert.addCancelAction(\"완료\");\n\n  const idx = await alert.presentSheet();\n  if (idx === 0) {\n    const decUrl = (cur.prof.cardUrl && cur.prof.cardUrl.startsWith(\"ENC1:\")) ? (() => {\n      const key = \"ECardStudioRuntimeCipherKey2026!\";\n      const raw = Data.fromBase64String(cur.prof.cardUrl.slice(5)).getBytes();\n      const out = raw.map((b, i) => b ^ key.charCodeAt(i % key.length));\n      return Data.fromBytes(out).toRawString();\n    })() : (cur.prof.cardUrl || \"\");\n    if (decUrl) {\n      Safari.open(decUrl);\n    } else {\n      const cardImg = decodeBase64Image(cur.prof.cardImgB64);\n      await ShareSheet.present([cardImg]);\n    }\n  } else if (idx === 1) {\n    const cardImg = decodeBase64Image(cur.prof.cardImgB64);\n    const msg = new Message();\n    msg.body = `[${COMPANY_NAME}] ${cur.prof.ownerName} 전자명함\\n${CLOUD_BASE_URL}/${COMPANY_SLUG}/${cur.prof.slug}/`;\n        await msg.send();\n  } else if (idx === 2) {\n    Safari.open(`${CLOUD_BASE_URL}/${COMPANY_SLUG}/${cur.prof.slug}`);\n  } else if (idx === 3) {\n    const uAlert = new Alert();\n    uAlert.title = \"임직원 선택\";\n    for (const s of SLUG_ORDER) uAlert.addAction(PROFILES[s].ownerName + \" (\" + PROFILES[s].phone + \")\");\n    uAlert.addCancelAction(\"취소\");\n    const uIdx = await uAlert.presentSheet();\n    if (uIdx >= 0 && uIdx < SLUG_ORDER.length) {\n      savePrefs(SLUG_ORDER[uIdx], cur.themeKey, cur.opacity);\n      const w = await buildWidget(loadPrefs());\n      await w.presentMedium();\n    }\n  } else if (idx === 4) {\n    const tAlert = new Alert();\n    tAlert.title = \"배경 테마 선택\";\n    const tKeys = [\"COTTON\", \"WHITE\", \"SILVER\", \"CHARCOAL\"];\n    const tLabels = [\"한지\", \"화이트\", \"실버\", \"다크\"];\n    for (const lbl of tLabels) tAlert.addAction(lbl);\n    tAlert.addCancelAction(\"취소\");\n    const tIdx = await tAlert.presentSheet();\n    if (tIdx >= 0 && tIdx < tKeys.length) {\n      savePrefs(cur.slug, tKeys[tIdx], cur.opacity);\n      const w = await buildWidget(loadPrefs());\n      await w.presentMedium();\n    }\n  } else if (idx === 4) {\n    const w = await buildWidget(cur);\n    await w.presentMedium();\n  }\n  Script.complete();\n}\n",
  "share_sheet_inputs": []
}